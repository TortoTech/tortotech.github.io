---
import '../styles/landing.css';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
// 统一为以 / 结尾，便于直接拼接子路径
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const zh = lang === 'zh';
const homeHref = zh ? base : `${base}en/`;
const docsHref = zh ? `${base}docs/` : `${base}en/docs/`;
const langHref = zh ? `${base}en/download/` : `${base}download/`;
const desktopReleasesUrl = 'https://github.com/TortoTech/torto/releases/latest';
const mobileReleasesUrl = 'https://github.com/TortoTech/torto-app/releases/latest';

const t = zh
  ? {
      title: '下载 Torto 小龟阅读 — 纯净本地优先阅读器',
      desc: '下载 Torto（小龟阅读）最新安装包：Windows 64位 MSI、macOS Apple Silicon / Intel DMG 与 Android APK。',
      navDocs: '使用文档',
      langLabel: 'English',
      h1: '下载 Torto 小龟阅读',
      sub: '全平台安装包均发布于 GitHub Releases，采用纯原生引擎构建，安全透明、无强制中转。',
      versionLoading: '正在获取最新发行版…',
      versionFallback: '前往 GitHub Releases 下载',
      platforms: [
        { name: 'Windows 桌面版', hint: 'Windows 10 / 11（64 位）· MSI 安装包', match: '.msi', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'macOS（Apple 芯片）', hint: 'macOS 15+ · M1/M2/M3/M4 系列芯片 · DMG', match: 'macos-arm64.dmg', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'macOS（Intel 芯片）', hint: 'macOS 15+ · Intel 处理器 · DMG', match: 'macos-x86_64.dmg', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'Android 移动端', hint: 'Android 7.0+ · ARM64 APK（主流手机架构）', match: 'android-arm64-v8a.apk', source: 'mobile', releasesUrl: mobileReleasesUrl },
      ],
      dlBtn: '立即下载',
      shortcutsTitle: '常用快捷键速查（全键盘沉浸操作）',
      shortcuts: [
        { key: 'Space', desc: '唤起单元浮动操作栏' },
        { key: 'Tab', desc: '打开当前段落随段 AI 伴读' },
        { key: '1 / 2', desc: '随段高亮 / 添加段落笔记' },
        { key: '3', desc: '智能按句分段（精读长难句）' },
        { key: '左 Alt', desc: '展开 / 收起随段折叠脚注' },
        { key: 'Ctrl + H', desc: '隐藏 / 显示鼠标光标' },
        { key: 'Ctrl + F', desc: '全书快速全文检索' },
        { key: 'Ctrl + ,', desc: '打开阅读器与排版设置' },
        { key: 'Ctrl + O', desc: '书架导入一本或多本书籍' },
        { key: 'Ctrl + Q', desc: '从阅读器返回封面书架' },
        { key: 'F11', desc: '切换无边框沉浸全屏' },
        { key: '↑ / ↓ / 回车', desc: '书架与目录全键盘漫游' },
      ],
      notesTitle: '安装与运行说明',
      notes: [
        'Windows：首次运行 MSI 安装包若出现 Windows Defender SmartScreen 提示，点击「更多信息」→「仍要运行」即可；安装后内置自动升级检查，升级前会按 SHA-256 校验安装包。',
        'macOS：首次打开若出现安全提示，请在「访达」中右键点击 Torto 图标选择「打开」，或在「系统设置 → 隐私与安全性」中选择「仍要打开」。',
        '校验文件：macOS DMG 发布包附带对应 .sha256 校验文件，可用于核对文件完整性；Windows MSI 由内置升级器依据 GitHub 发布摘要自动校验。',
        'Android：与桌面端保持同一版本节奏。绝大多数设备请下载 arm64-v8a；旧款 32 位设备选用 armeabi-v7a，模拟器或 Intel 设备选用 x86_64；应用内「关于」页可检查新版本。',
      ],
      ocrTip: '安装完成后，推荐查阅以下指南以开启高级功能：',
      ocrLink1: 'OCR 服务商配置（扫描 PDF 转文字）',
      ocrLink2: '私有 WebDAV 云同步配置',
      ocrLink3: '专注模式精读指南',
      andText: '、',
      sentenceEnd: '。',
      footerCopy: '© {year} Torto 小龟阅读 · 基于 AGPL-3.0 协议开源',
    }
  : {
      title: 'Download Torto Reader — Local-First Ebook Reader',
      desc: 'Download Torto Reader installers: Windows 64-bit MSI, macOS Apple Silicon / Intel DMG, and Android APK.',
      navDocs: 'Docs',
      langLabel: '简体中文',
      h1: 'Download Torto Reader',
      sub: 'All installers are published transparently on GitHub Releases, built with pure native pipelines without web wrapper overhead.',
      versionLoading: 'Fetching latest release info…',
      versionFallback: 'Get latest on GitHub Releases',
      platforms: [
        { name: 'Windows Desktop', hint: 'Windows 10 / 11 (64-bit) · MSI Installer', match: '.msi', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'macOS (Apple Silicon)', hint: 'macOS 15+ · M1/M2/M3/M4 Series · DMG', match: 'macos-arm64.dmg', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'macOS (Intel)', hint: 'macOS 15+ · Intel Processors · DMG', match: 'macos-x86_64.dmg', source: 'desktop', releasesUrl: desktopReleasesUrl },
        { name: 'Android Mobile', hint: 'Android 7.0+ · ARM64 APK (most phones)', match: 'android-arm64-v8a.apk', source: 'mobile', releasesUrl: mobileReleasesUrl },
      ],
      dlBtn: 'Download Now',
      shortcutsTitle: 'Essential Keyboard Shortcuts (All-Keyboard Immersion)',
      shortcuts: [
        { key: 'Space', desc: 'Toggle floating action bar' },
        { key: 'Tab', desc: 'Open context-bound AI chat' },
        { key: '1 / 2', desc: 'Highlight / Add unit note' },
        { key: '3', desc: 'Sentence splitting for close reading' },
        { key: 'Left Alt', desc: 'Toggle folded footnote popup' },
        { key: 'Ctrl + H', desc: 'Toggle mouse cursor visibility' },
        { key: 'Ctrl + F', desc: 'Instant full-text book search' },
        { key: 'Ctrl + ,', desc: 'Open settings overlay' },
        { key: 'Ctrl + O', desc: 'Import books into shelf' },
        { key: 'Ctrl + Q', desc: 'Back to library shelf' },
        { key: 'F11', desc: 'Toggle borderless fullscreen' },
        { key: '↑ / ↓ / Enter', desc: 'Shelf and TOC keyboard roaming' },
      ],
      notesTitle: 'Installation & Verification Notes',
      notes: [
        'Windows: SmartScreen may flag the first run. Click "More info" → "Run anyway". The built-in updater checks GitHub Releases and verifies the installer with SHA-256 before upgrading.',
        'macOS: On first launch, right-click Torto in Finder and select "Open", or allow it under "System Settings → Privacy & Security".',
        'Integrity: macOS DMG releases ship a matching .sha256 checksum file; the Windows MSI is verified automatically by the built-in updater against the GitHub release digest.',
        'Android: Released on the same cadence as the desktop app. Choose arm64-v8a for most modern devices, armeabi-v7a for older 32-bit phones, and x86_64 for emulators or Intel devices; the About page checks for new versions.',
      ],
      ocrTip: 'After installing, explore the configuration guides for advanced capabilities:',
      ocrLink1: 'OCR Providers (Scanned PDF Reflow)',
      ocrLink2: 'Private WebDAV Cloud Sync',
      ocrLink3: 'Focus Mode Guide',
      andText: ', ',
      sentenceEnd: '.',
      footerCopy: '© {year} Torto · AGPL-3.0 License',
    };
---

<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="icon" type="image/png" href={`${base}images/logo.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <script define:vars={{ base }}>
      (function () {
        var KEY = 'torto-lang';
        var rel = location.pathname.slice(base.length - 1);
        var isEn = rel === '/en' || rel.indexOf('/en/') === 0;
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        var pref = stored || ((navigator.language || 'en').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
        if (pref === 'en' && !isEn) location.replace(base + 'en/download/');
        else if (pref === 'zh' && isEn) location.replace(base + 'download/');
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a.lang-switch') : null;
          if (a) { try { localStorage.setItem(KEY, isEn ? 'zh' : 'en'); } catch (err) {} }
        }, true);
      })();
    </script>
  </head>
  <body>
    <!-- 顶部导航 -->
    <nav class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={homeHref}>
          <img src={`${base}images/logo.png`} alt="Torto" />
          <div class="brand-text">
            <span>Torto</span>
            {zh && <span class="brand-sub">小龟阅读</span>}
          </div>
        </a>
        <div class="nav-links">
          <a href={docsHref}>{t.navDocs}</a>
          <a href="https://github.com/TortoTech/torto" target="_blank" rel="noopener">GitHub</a>
          <a class="lang-switch" href={langHref}>{t.langLabel}</a>
        </div>
      </div>
    </nav>

    <!-- 下载内容主体 -->
    <main class="section wrap">
      <div class="center">
        <span class="section-kicker">Releases & Packages</span>
        <h1>{t.h1}</h1>
        <p class="sub">{t.sub}</p>
      </div>

      <div class="dl-grid" id="dl-grid" data-locale={zh ? 'zh-CN' : 'en'}>
        {t.platforms.map((p) => (
          <div class="dl-card" data-match={p.match} data-source={p.source}>
            <h3>{p.name}</h3>
            <div class="meta">{p.hint}</div>
            <div class="meta version">{t.versionLoading}</div>
            <a class="btn btn-primary dl-btn" href={p.releasesUrl} target="_blank" rel="noopener">
              {t.dlBtn}
            </a>
          </div>
        ))}
      </div>

      <!-- 快捷键速查表 -->
      <div class="shortcuts-table-wrap">
        <h3>{t.shortcutsTitle}</h3>
        <div class="shortcuts-grid">
          {t.shortcuts.map((s) => (
            <div class="shortcut-item">
              <span class="kbd-tag">{s.key}</span>
              <span>{s.desc}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 安装说明 -->
      <div class="dl-notes">
        <h3>{t.notesTitle}</h3>
        <ul>
          {t.notes.map((n) => <li>{n}</li>)}
        </ul>
        <p style="margin: 20px 0 0; color: var(--text-sub); font-size: 14.5px; line-height: 1.8;">
          {t.ocrTip}{' '}
          <a href={zh ? `${base}guides/ocr-providers/` : `${base}en/guides/ocr-providers/`}>{t.ocrLink1}</a>
          {t.andText}
          <a href={zh ? `${base}guides/cloud-storage/` : `${base}en/guides/cloud-storage/`}>{t.ocrLink2}</a>
          {t.andText}
          <a href={zh ? `${base}guides/focus-mode/` : `${base}en/guides/focus-mode/`}>{t.ocrLink3}</a>
          {t.sentenceEnd}
        </p>
      </div>
    </main>

    <!-- 页脚 -->
    <footer class="footer">
      <div class="wrap footer-inner">
        <span>{t.footerCopy.replace('{year}', String(new Date().getFullYear()))}</span>
        <a href={docsHref}>{zh ? '文档指南' : 'Documentation'}</a>
        <span class="right"><a href="https://github.com/TortoTech" target="_blank" rel="noopener">github.com/TortoTech</a></span>
      </div>
    </footer>

    <!-- 动态拉取 Release 脚本 -->
    <script define:vars={{ desktopReleasesUrl, mobileReleasesUrl }}>
      (function () {
        const grid = document.getElementById('dl-grid');
        if (!grid) return;
        const locale = grid.dataset.locale || 'en';

        // 平台智能检测
        async function detectMatch() {
          const ua = navigator.userAgent;
          if (/Android/i.test(ua)) return { source: 'mobile', match: 'android-arm64-v8a.apk' };
          if (/Windows/i.test(ua)) return { source: 'desktop', match: '.msi' };
          if (/Mac OS X|Macintosh/i.test(ua)) {
            try {
              if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
                const v = await navigator.userAgentData.getHighEntropyValues(['architecture']);
                return { source: 'desktop', match: v.architecture === 'arm' ? 'macos-arm64.dmg' : 'macos-x86_64.dmg' };
              }
            } catch {}
            return { source: 'desktop', match: 'macos-arm64.dmg' };
          }
          return null;
        }

        (async () => {
          const match = await detectMatch();
          if (!match) return;
          const card = grid.querySelector(`.dl-card[data-source="${match.source}"][data-match="${match.match}"]`);
          if (!card) return;
          card.classList.add('recommended');
          const badge = document.createElement('span');
          badge.className = 'dl-badge';
          badge.textContent = locale === 'zh-CN' ? '系统匹配推荐' : 'Recommended';
          card.prepend(badge);
        })();

        // GitHub Releases API 动态拉取具体文件名
        (async () => {
          try {
            const sources = {
              desktop: {
                url: 'https://api.github.com/repos/TortoTech/torto/releases/latest',
                fallback: desktopReleasesUrl,
              },
              mobile: {
                url: 'https://api.github.com/repos/TortoTech/torto-app/releases/latest',
                fallback: mobileReleasesUrl,
              },
            };
            const releases = {};
            await Promise.all(Object.entries(sources).map(async ([key, source]) => {
              try {
                const res = await fetch(source.url);
                if (!res.ok) throw new Error(String(res.status));
                releases[key] = await res.json();
              } catch {
                releases[key] = null;
              }
            }));

            for (const card of grid.querySelectorAll('.dl-card')) {
              const sourceKey = card.dataset.source;
              const match = card.dataset.match;
              const data = releases[sourceKey];
              const source = sources[sourceKey];
              const asset = (data?.assets || []).find(
                (a) => a.name && a.name.endsWith(match)
              );
              const versionEl = card.querySelector('.version');
              const btn = card.querySelector('.dl-btn');
              if (versionEl) {
                versionEl.textContent = data?.tag_name ? `${data.tag_name}` : source.fallback;
                if (!data) {
                  versionEl.style.fontSize = '12px';
                  versionEl.style.wordBreak = 'break-all';
                }
              }
              if (asset && btn) btn.href = asset.browser_download_url;
            }
          } catch {
            for (const versionEl of grid.querySelectorAll('.version')) {
              versionEl.textContent = versionEl.closest('.dl-card')?.dataset.source === 'mobile'
                ? mobileReleasesUrl
                : desktopReleasesUrl;
              versionEl.style.fontSize = '12px';
              versionEl.style.wordBreak = 'break-all';
            }
          }
        })();
      })();
    </script>
  </body>
</html>
