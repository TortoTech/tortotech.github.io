---
import '../styles/landing.css';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
// 统一为以 / 结尾，便于直接拼接子路径
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const zh = lang === 'zh';
const homeHref = zh ? base : `${base}en/`;
const docsHref = zh ? `${base}docs/` : `${base}en/docs/`;
const downloadHref = zh ? `${base}download/` : `${base}en/download/`;
const langHref = zh ? `${base}en/` : base;

const t = zh
  ? {
      title: 'Torto 小龟阅读 — 专注精读 · 纸墨雅致的本地优先电子书阅读器',
      desc: 'Torto（小龟阅读）是一款支持 Windows、macOS 与 Android 的本地优先电子书阅读器。一次只专注于一个有意义的阅读单元、统一排版、键盘操作优先、零干扰。',
      navDocs: '使用文档',
      navDownload: '下载安装',
      langLabel: 'English',
      badge: '开源免费 · Windows · macOS · Android',
      h1Prefix: '在喧嚣时代，重拾',
      h1Highlight: '「 专注精读 」',
      h1Suffix: '',
      lead: '一次只专注于一个有意义的阅读单元、统一排版、键盘操作优先、零干扰',
      ctaDownload: '立即下载体验',
      ctaDocs: '查阅使用文档',

      // 截图
      shotsLibrary: 'Torto 书架界面',
      shotsReader: 'Torto 阅读器界面',

      // 跨端模型
      platformTitle: '桌面与移动端，共享同一座专属书库',
      platformSub: '桌面端以原生 Rust 渲染管线打造，移动端以纯 Dart 阅读内核实现，均无臃肿外壳，通过你自己的私有云盘实现无缝同步。',
      platforms: [
        {
          label: '桌面端 · v0.6.2',
          title: 'Windows 与 macOS',
          text: '完整的专注精读模式、继承 Typst 的优雅排版、可选 AI 辅助排版与公式识别、随段 AI 伴读、阅读统计、扫描 PDF 智能转文字与全格式支持。',
          primary: '下载桌面版 (MSI / DMG)',
          primaryHref: downloadHref,
          secondary: '桌面端源码',
          secondaryHref: 'https://github.com/TortoTech/torto',
        },
        {
          label: '移动端 · v0.6.2',
          title: 'Android 7.0+',
          text: '原生轻快阅读体验，支持专注模式与按句分段、AI 辅助排版、双语翻译、全文搜索、阅读统计，并与电脑端实时同步。',
          primary: '下载 Android APK',
          primaryHref: downloadHref,
          secondary: '移动端源码',
          secondaryHref: 'https://github.com/TortoTech/torto-app',
        },
      ],

      // 四大书房特性
      featKicker: '精雕细琢 · 书房美学',
      featTitle: '专为纯粹阅读者打造的核心体验',
      featSub: '告别浮躁与复杂设置，每一个功能都为你营造安宁、舒适与沉浸的读书氛围。',
      themes: [
        {
          num: '01',
          title: '沉浸 · 专注精读模式',
          desc: '视线不跳动，一次只读一段',
          items: [
            { icon: '◎', title: '逐段自然推进', text: '将正文拆分为自然的段落与图表单元，每次聚焦当下，读书更有节奏。' },
            { icon: '⚓', title: '居中视线锚定', text: '当前阅读段落始终保持在最舒适的视野中心，换段不再上下找字。' },
            { icon: '✂', title: '智能按句拆读 (按 3)', text: '遇到长难段落一键切分为清晰短句，成对引号与标点完好保留，精读更轻松。' },
            { icon: '✎', title: '随段笔记与高亮', text: '随手划选句子与段落，添加的心得笔记精准附在原文旁，随时回看。' },
            { icon: '✦', title: '折叠脚注 (按 Alt)', text: '注解自动收拢为精巧小标记，按左 Alt 键或点击即可查看，不打乱正文节奏。' },
            { icon: '⌨', title: '鼠标自动隐藏 (Ctrl+H)', text: '进入精读后鼠标光标自动隐形，纯键盘沉浸漫游，无屏幕杂讯干扰。' },
          ],
        },
        {
          num: '02',
          title: '纯粹 · 纸墨排版之美',
          desc: '继承 Typst 排版经验，还原纸质书质感',
          items: [
            { icon: '⚡', title: '纯原生轻快引擎', text: '不嵌入浏览器或 WebView，由 Rust 自行完成解析、排版、分页与渲染，瞬间打开大部头书籍，翻页如丝般顺滑。' },
            { icon: '¶', title: '继承 Typst 排版经验', text: '精细优化中文标点避头尾、字距挤压、两端对齐与自动断词，呈现出版物级别的整洁版面。' },
            { icon: '▤', title: '原书版式保真', text: '智能识别并保留作者署名居右、诗歌题记居中等原始特色设计。' },
            { icon: 'Aa', title: '一键统一排版', text: '自动规范字号、行距与段落间距，也可以随时切回电子书原厂样式。' },
            { icon: '◫', title: '三种经典视图', text: '提供单栏、双栏以及类似网页的纵向连读模式，随心选用。' },
            { icon: '▦', title: '表格直接复制为 Markdown', text: '书中复杂的统计表格一键复制为标准 Markdown 格式，方便整理读书笔记。' },
          ],
        },
        {
          num: '03',
          title: '敏睿 · AI 伴读与智能排版',
          desc: '紧扣当前原文，有理有据地启发思考',
          items: [
            { icon: '💬', title: '随段 AI 伴读 (按 Tab)', text: 'AI 对话严格绑定当前段落，可围绕图片提问；输入 / 唤起阅读技能、@ 添加引用，针对性解析难点与翻译。' },
            { icon: '🧭', title: 'AI 辅助排版', text: '可选模型自动识别小节标题、有来源的引用与图表注释，并补充缺失署名，让解析结果更接近原书结构。' },
            { icon: '∑', title: '公式识别与 LaTeX 复制', text: '识别文字与图片中的公式并原生渲染，失败自动回退原图，支持查看原图与复制 LaTeX。' },
            { icon: '🔗', title: '严格标明原文出处', text: '文内引用收纳为编号标记，AI 回答附带书中具体段落链接，点击立刻跳回原文验证。' },
            { icon: '🔍', title: '全书快速搜索', text: '快速查找书中任意词句，精准展示上下文片段并一键定位。' },
            { icon: '🌐', title: '全书双语对照翻译', text: '外文原著可一键开启双语对照或替换阅读，目录也能同步翻译。' },
          ],
        },
        {
          num: '04',
          title: '自在 · 跨端书库与阅读统计',
          desc: '数据尽在本地，全格式兼容与私有云同步',
          items: [
            { icon: '📚', title: '支持所有主流格式', text: 'EPUB, MOBI, AZW/AZW3, FB2/FBZ, CBZ 漫画, CHM 资料与 PDF 均能直接阅读。' },
            { icon: '⌨', title: '全键盘选书漫游', text: '无需鼠标，方向键直接在书架封面间穿梭，回车即可翻开阅读。' },
            { icon: '📈', title: '阅读统计与回顾', text: '自动记录阅读时长、历史与读完状态，五分钟无操作自动暂停，支持多设备云同步。' },
            { icon: '📄', title: '扫描版 PDF 智能转文字', text: '内置 OCR 识别引擎，将影印版 PDF 转为可调字号的排版文字；识别结果还可同步到手机继续阅读。' },
            { icon: '☁', title: '私有云盘无缝同步', text: '通过中国科技云、坚果云等私有 WebDAV 同步书库、进度、高亮、笔记与统计，数据不经任何第三方中转。' },
            { icon: '🔒', title: '安全隐私第一', text: '书籍与账号密码仅保存在系统安全存储中，绝不偷偷上传你的书库内容。' },
          ],
        },
      ],

      bannerH2: '翻开书卷，回归沉静精读',
      bannerP: '免费下载 Torto 小龟阅读，支持 Windows 10/11、macOS 15+ 与 Android 7.0+。',
      footerCopy: '© {year} Torto 小龟阅读 · 基于 AGPL-3.0 协议开源',
      footerDocs: '文档指南',
      footerReleases: '版本更新日志',
    }
  : {
      title: 'Torto Reader — Focus Reading & Typst-Inspired Typography',
      desc: 'Torto is a local-first ebook reader for Windows, macOS and Android. Focusing on one meaningful unit at a time, unified typography, keyboard-first navigation, and zero distractions.',
      navDocs: 'Docs',
      navDownload: 'Download',
      langLabel: '简体中文',
      badge: 'Free & Open Source · Windows · macOS · Android',
      h1Prefix: 'Rediscover the Joy of',
      h1Highlight: '「 Focus Reading 」',
      h1Suffix: '',
      lead: 'Focusing on one meaningful unit at a time, unified typography, keyboard-first navigation, and zero distractions.',
      ctaDownload: 'Download Torto',
      ctaDocs: 'Explore the Docs',

      // Screenshots
      shotsLibrary: 'Torto Shelf View',
      shotsReader: 'Torto Reader View',

      // Cross-platform
      platformTitle: 'One reading model across desktop and mobile',
      platformSub: 'A native Rust rendering pipeline on desktop and a pure-Dart reading core on mobile, both free of browser bloat and syncing directly through your private cloud.',
      platforms: [
        {
          label: 'Desktop · v0.6.2',
          title: 'Windows & macOS',
          text: 'The full Focus Mode experience, Typst-inspired typography, optional AI-assisted layout with formula recognition, context-bound AI companion, reading statistics, scanned PDF reflow and multi-format support.',
          primary: 'Download Desktop (MSI / DMG)',
          primaryHref: downloadHref,
          secondary: 'Desktop Source',
          secondaryHref: 'https://github.com/TortoTech/torto',
        },
        {
          label: 'Mobile · v0.6.2',
          title: 'Android 7.0+',
          text: 'Native lightweight reading with Focus Mode and sentence splitting, AI-assisted layout, bilingual translation, full-text search, reading statistics and real-time desktop sync.',
          primary: 'Download Android APK',
          primaryHref: downloadHref,
          secondary: 'Mobile Source',
          secondaryHref: 'https://github.com/TortoTech/torto-app',
        },
      ],

      // Themes
      featKicker: 'Carefully Crafted · Reading Studio',
      featTitle: 'Built for Discerning Readers',
      featSub: 'Every feature is purposefully designed to foster a calm, serene, and deeply focused reading atmosphere.',
      themes: [
        {
          num: '01',
          title: 'Immersive · Focus Reading Mode',
          desc: 'One meaningful passage at a time with steady eye focus',
          items: [
            { icon: '◎', title: 'Semantic Unit Flow', text: 'Advances smoothly paragraph by paragraph so your mind stays in flow.' },
            { icon: '⚓', title: 'Centered Baseline Anchor', text: 'The active paragraph stays centered in your comfortable line of sight.' },
            { icon: '✂', title: 'Sentence Splitting (Key 3)', text: 'Split long dense paragraphs into clear sentences for effortless close reading.' },
            { icon: '✎', title: 'Inline Notes & Highlights', text: 'Select text freely and attach notes that remain permanently tied to the exact passage.' },
            { icon: '✦', title: 'Folded Footnotes (Key Alt)', text: 'Footnotes collapse into neat badge icons that expand instantly on demand.' },
            { icon: '⌨', title: 'Auto-Hidden Cursor (Ctrl+H)', text: 'The cursor fades away automatically in Focus Mode for zero visual distraction.' },
          ],
        },
        {
          num: '02',
          title: 'Pure · Typst-Inspired Typography',
          desc: 'Clean, elegant, publication-grade reading layouts',
          items: [
            { icon: '⚡', title: 'Native Lightweight Engine', text: 'No embedded browser or WebView. Parsing, typesetting, pagination and rendering are done natively in Rust for instant starts and butter-smooth scrolling.' },
            { icon: '¶', title: 'Typst-Inspired Linebreaking', text: 'Advanced CJK punctuation hanging and compression, justified alignment and automatic hyphenation for book-like layout quality.' },
            { icon: '▤', title: 'Authored Style Fidelity', text: 'Preserves author signatures, centered quotes, and artistic book layouts faithfully.' },
            { icon: 'Aa', title: 'Unified Typography', text: 'Normalize font sizes, line heights, and margins with one click, or toggle back anytime.' },
            { icon: '◫', title: 'Three Classic Views', text: 'Choose between single-column, two-column spread, or continuous vertical scroll.' },
            { icon: '▦', title: 'Markdown Table Export', text: 'Copy complex book tables directly as standard Markdown for your personal notes.' },
          ],
        },
        {
          num: '03',
          title: 'Grounded · AI Companion & Smart Layout',
          desc: 'Attached strictly to active context with exact citations',
          items: [
            { icon: '💬', title: 'Unit-Bound Chat (Key Tab)', text: 'AI discussions attach to the active passage and can reason about images; type / for reading skills and @ to add citations.' },
            { icon: '🧭', title: 'AI-Assisted Layout', text: 'An optional model recognizes section headings, sourced quotations and figure or table captions, and completes missing attributions.' },
            { icon: '∑', title: 'Formula Recognition & LaTeX', text: 'Recognizes formulas in text and images, renders them natively, falls back to the original image on failure, and copies LaTeX.' },
            { icon: '🔗', title: 'Exact Source Citations', text: 'Inline references fold into numbered markers, and AI answers include clickable paragraph citations jumping to the source text.' },
            { icon: '🔍', title: 'Instant Full-Text Search', text: 'Quickly find any passage across the book with matching excerpts and 1-click navigation.' },
            { icon: '🌐', title: 'Bilingual Book Translation', text: 'Read foreign classics with parallel bilingual view or full replacement translation.' },
          ],
        },
        {
          num: '04',
          title: 'Open · Local Library & Reading Stats',
          desc: 'Private data, wide format support, and direct WebDAV sync',
          items: [
            { icon: '📚', title: 'All Major Ebook Formats', text: 'Read DRM-free EPUB, MOBI, AZW/AZW3, FB2/FBZ, CBZ comics, CHM docs, and PDF.' },
            { icon: '⌨', title: 'All-Keyboard Shelf Navigation', text: 'Browse book covers and start reading entirely with arrow keys and Enter.' },
            { icon: '📈', title: 'Reading Statistics & Review', text: 'Automatically tracks reading time, history and completion, pauses after five idle minutes, and syncs across devices.' },
            { icon: '📄', title: 'Scanned PDF OCR & Reflow', text: 'Recognize scanned PDFs into reflowable text with adjustable fonts; recognized layouts can sync to your phone.' },
            { icon: '☁', title: 'Direct WebDAV Cloud Sync', text: 'Sync books, progress, highlights, notes and statistics between desktop and mobile with zero third-party relay.' },
            { icon: '🔒', title: 'Privacy & Security First', text: 'Credentials stay in your OS secure vault. Books are never uploaded without consent.' },
          ],
        },
      ],

      bannerH2: 'Open a Book and Experience True Focus',
      bannerP: 'Download Torto Reader for free on Windows 10/11, macOS 15+ and Android 7.0+.',
      footerCopy: '© {year} Torto · AGPL-3.0 License',
      footerDocs: 'Documentation',
      footerReleases: 'Changelog',
    };
---

<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="icon" type="image/png" href={`${base}images/logo.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <script define:vars={{ base }}>
      (function () {
        var KEY = 'torto-lang';
        var rel = location.pathname.slice(base.length - 1);
        var isEn = rel === '/en' || rel.indexOf('/en/') === 0;
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        var pref = stored || ((navigator.language || 'en').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
        if (pref === 'en' && !isEn) location.replace(base + 'en' + (rel === '/' ? '/' : rel));
        else if (pref === 'zh' && isEn) location.replace(base + rel.replace(/^\/en\/?/, '') || base);
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a.lang-switch') : null;
          if (a) { try { localStorage.setItem(KEY, isEn ? 'zh' : 'en'); } catch (err) {} }
        }, true);
      })();
    </script>
  </head>
  <body>
    <!-- 顶部导航 -->
    <nav class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={homeHref}>
          <img src={`${base}images/logo.png`} alt="Torto" />
          <div class="brand-text">
            <span>Torto</span>
            {zh && <span class="brand-sub">小龟阅读</span>}
          </div>
        </a>
        <div class="nav-links">
          <a href={docsHref}>{t.navDocs}</a>
          <a href="https://github.com/TortoTech/torto" target="_blank" rel="noopener">GitHub</a>
          <a class="lang-switch" href={langHref}>{t.langLabel}</a>
          <a class="nav-cta" href={downloadHref}>{t.navDownload}</a>
        </div>
      </div>
    </nav>

    <!-- Hero 区域 -->
    <header class="hero">
      <div class="wrap hero-inner">
        <div class="hero-badge-wrap">
          <span class="hero-badge-dot"></span>
          <span>{t.badge}</span>
        </div>
        <h1>
          {t.h1Prefix}<span class="highlight-serif">{t.h1Highlight}</span>{t.h1Suffix}
        </h1>
        <p class="lead">{t.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={downloadHref}>{t.ctaDownload}</a>
          <a class="btn btn-ghost" href={docsHref}>{t.ctaDocs}</a>
        </div>
      </div>
    </header>

    <!-- 实机截图对比（纯净大图） -->
    <section class="screenshots wrap">
      <div class="shot-grid">
        <figure>
          <img src={`${base}images/library.png`} alt={t.shotsLibrary} loading="lazy" />
        </figure>
        <figure>
          <img src={`${base}images/reader.png`} alt={t.shotsReader} loading="lazy" />
        </figure>
      </div>
    </section>

    <!-- 跨端架构 -->
    <section class="section wrap" id="platforms">
      <div class="center">
        <span class="section-kicker">Cross Platform</span>
        <h2>{t.platformTitle}</h2>
        <p class="sub">{t.platformSub}</p>
      </div>
      <div class="platform-grid">
        {t.platforms.map((platform) => (
          <article class="platform-card">
            <span class="platform-kicker">{platform.label}</span>
            <h3>{platform.title}</h3>
            <p>{platform.text}</p>
            <div class="platform-links">
              <a class="btn btn-primary" href={platform.primaryHref}>{platform.primary}</a>
              <a class="text-link" href={platform.secondaryHref} target="_blank" rel="noopener">{platform.secondary} ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 四大书房特性板块 -->
    <section class="section wrap" id="features">
      <div class="center">
        <span class="section-kicker">{t.featKicker}</span>
        <h2>{t.featTitle}</h2>
        <p class="sub">{t.featSub}</p>
      </div>

      <div class="features-container">
        {t.themes.map((theme) => (
          <div class="feature-theme-block">
            <div class="feature-theme-header">
              <span class="feature-theme-num">{theme.num}</span>
              <span class="feature-theme-title">{theme.title}</span>
              <span class="feature-theme-desc">{theme.desc}</span>
            </div>
            <div class="theme-grid">
              {theme.items.map((item) => (
                <div class="feature-item">
                  <div class="feature-item-icon">{item.icon}</div>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 底部行动呼吁 -->
    <section class="wrap">
      <div class="banner">
        <h2>{t.bannerH2}</h2>
        <p>{t.bannerP}</p>
        <a class="btn btn-primary" href={downloadHref}>{t.ctaDownload}</a>
      </div>
    </section>

    <!-- 优雅页脚 -->
    <footer class="footer">
      <div class="wrap footer-inner">
        <span>{t.footerCopy.replace('{year}', String(new Date().getFullYear()))}</span>
        <a href={docsHref}>{t.footerDocs}</a>
        <a href="https://github.com/TortoTech/torto/releases" target="_blank" rel="noopener">{t.footerReleases}</a>
        <span class="right"><a href="https://github.com/TortoTech" target="_blank" rel="noopener">github.com/TortoTech</a></span>
      </div>
    </footer>
  </body>
</html>
