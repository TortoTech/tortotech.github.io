---
import '../styles/landing.css';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
// 统一为以 / 结尾，便于直接拼接子路径
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const zh = lang === 'zh';
const homeHref = zh ? base : `${base}en/`;
const docsHref = zh ? `${base}docs/` : `${base}en/docs/`;
const downloadHref = zh ? `${base}download/` : `${base}en/download/`;
const langHref = zh ? `${base}en/` : base;

const t = zh
  ? {
      title: 'Torto 小龟阅读 — 以专注模式为核心的本地优先电子书阅读器',
      desc: 'Torto（小龟阅读）是一款支持 Windows、macOS 与 Android 的本地优先电子书阅读器，以专注模式、原生渲染、统一版式和可选 AI 阅读工具重新组织数字阅读体验。',
      navDocs: '使用文档',
      navDownload: '下载',
      langLabel: 'EN',
      badge: '开源免费 · Windows · macOS · Android',
      h1: '小龟阅读 Torto',
      lead: '一次专注于一个有意义的阅读单元。桌面端以原生 Rust、移动端以原生 Dart 构建，不依赖 WebView，书库与阅读数据始终由你掌控。',
      ctaDownload: '立即下载',
      ctaDocs: '查看使用文档',
      shotsLibrary: '本地书架 — 封面与元数据、批量导入、搜索与最近阅读',
      shotsReader: '经典阅读 — 单栏、双栏与连续滑动，统一版式或跟随原书',
      platformTitle: '桌面与移动，使用同一套阅读模型',
      platformSub: '桌面端与 Android 端分别使用 Rust 和 Dart 原生实现，并通过兼容的 WebDAV 协议连接同一座书库。',
      platforms: [
        {
          label: '桌面端',
          title: 'Windows 与 macOS',
          text: '完整的专注模式、经典布局、标注、AI 对话与翻译、语义搜索、PDF OCR，以及直接 WebDAV 同步。',
          primary: '下载桌面版',
          primaryHref: downloadHref,
          secondary: '桌面端源码',
          secondaryHref: 'https://github.com/TortoTech/torto',
        },
        {
          label: '移动端 · v0.1',
          title: 'Android 7.0+',
          text: '原生 Dart 阅读管线，支持多格式导入、统一版式、目录与进度恢复，并可与桌面端直接同步书籍和阅读状态。',
          primary: '下载 Android APK',
          primaryHref: downloadHref,
          secondary: '移动端源码',
          secondaryHref: 'https://github.com/TortoTech/torto-app',
        },
      ],
      featTitle: '功能特性',
      featSub: '从段落级精读到跨设备书库，围绕稳定、可定位的 Reading IR 构建。',
      features: [
        { icon: '◎', title: '专注模式', text: '桌面端默认逐个语义单元推进；当前段落保持在稳定位置，聊天、高亮、批注与脚注都跟随上下文。' },
        { icon: '▤', title: '多格式支持', text: '阅读无 DRM 的 EPUB、MOBI、AZW/AZW3、FB2/FBZ、CBZ、CHM 与 PDF。' },
        { icon: '⚡', title: '双原生渲染管线', text: '桌面端由 Rust 解析、排版与 GPU 渲染；Android 端由 Dart 与 Flutter Canvas 独立实现。' },
        { icon: 'Aa', title: '统一版式', text: '统一标题、正文、列表、引用、表格、图片与图注，也可以切回电子书原有样式。' },
        { icon: '¶', title: '结构化正文', text: '识别段落、嵌套列表、引用、表格、图片、图注与脚注，让导航和交互落在正确的阅读单元上。' },
        { icon: '✎', title: '选择与标注', text: '自由或按词、句、段选择，复制、高亮和批注都保留可跳转的原文位置。' },
        { icon: '✦', title: 'AI 阅读工具', text: '可选的流式对话与原文引用、翻译和本地语义搜索；模型与服务商由用户自行配置。' },
        { icon: '▧', title: 'PDF OCR 重排', text: '识别扫描版 PDF 的正文、目录与元数据，在原始页面和可重排文字版式之间切换。' },
        { icon: '☁', title: '跨设备 WebDAV 同步', text: '桌面与 Android 通过你的 WebDAV 直接同步书籍、阅读进度及可兼容的阅读数据，无 Torto 中转。' },
      ],
      bannerH2: '准备好开始阅读了吗？',
      bannerP: '免费下载 Torto，支持 Windows 10/11、macOS 12+ 与 Android 7.0+。',
      footerCopy: '© {year} Torto 小龟阅读 · MIT License',
      footerDocs: '文档',
      footerReleases: '更新日志',
    }
  : {
      title: 'Torto — A local-first ebook reader built around Focus Mode',
      desc: 'Torto is a local-first ebook reader for Windows, macOS and Android, built around Focus Mode, native rendering, unified typography and optional AI reading tools.',
      navDocs: 'Docs',
      navDownload: 'Download',
      langLabel: '中文',
      badge: 'Free & Open Source · Windows · macOS · Android',
      h1: 'Torto Reader',
      lead: 'Focus on one meaningful reading unit at a time. Native Rust on desktop and native Dart on mobile — no WebView, with your library and reading data under your control.',
      ctaDownload: 'Download Now',
      ctaDocs: 'Read the Docs',
      shotsLibrary: 'Local library — covers and metadata, bulk import, search and recent reading',
      shotsReader: 'Classic reading — single-column, two-column and continuous scroll with unified or authored typography',
      platformTitle: 'One reading model across desktop and mobile',
      platformSub: 'The desktop and Android apps use independent native Rust and Dart implementations connected by a compatible direct WebDAV protocol.',
      platforms: [
        {
          label: 'Desktop',
          title: 'Windows & macOS',
          text: 'The complete Focus Mode experience, classic layouts, annotations, AI chat and translation, semantic search, PDF OCR and direct WebDAV sync.',
          primary: 'Download desktop',
          primaryHref: downloadHref,
          secondary: 'Desktop source',
          secondaryHref: 'https://github.com/TortoTech/torto',
        },
        {
          label: 'Mobile · v0.1',
          title: 'Android 7.0+',
          text: 'A native Dart reading pipeline with multi-format import, unified typography, table-of-contents navigation, progress restoration and desktop-compatible WebDAV sync.',
          primary: 'Download Android APK',
          primaryHref: downloadHref,
          secondary: 'Mobile source',
          secondaryHref: 'https://github.com/TortoTech/torto-app',
        },
      ],
      featTitle: 'Features',
      featSub: 'From passage-level close reading to a cross-device library, all built on stable, source-addressable Reading IR.',
      features: [
        { icon: '◎', title: 'Focus Mode', text: 'Advance one semantic unit at a time on desktop. Chat, highlights, notes and footnotes stay attached to the active context.' },
        { icon: '▤', title: 'Multi-format', text: 'Read DRM-free EPUB, MOBI, AZW/AZW3, FB2/FBZ, CBZ, CHM and PDF files.' },
        { icon: '⚡', title: 'Two Native Pipelines', text: 'Rust parses, lays out and renders on desktop; Dart and Flutter Canvas independently power Android.' },
        { icon: 'Aa', title: 'Unified Typography', text: 'Normalize headings, prose, lists, quotes, tables, figures and captions, or switch back to authored styles.' },
        { icon: '¶', title: 'Structured Reading', text: 'Preserve paragraphs, nested lists, quotations, tables, images, captions and footnotes as meaningful reading units.' },
        { icon: '✎', title: 'Selection & Annotations', text: 'Select freely or by word, sentence or paragraph, then copy, highlight or annotate durable source locations.' },
        { icon: '✦', title: 'AI Reading Tools', text: 'Optional streaming chat with source citations, translation and local semantic search using providers you configure.' },
        { icon: '▧', title: 'PDF OCR & Reflow', text: 'Recognize body text, contents and metadata, then switch between original pages and a reflowable text layout.' },
        { icon: '☁', title: 'Cross-device WebDAV', text: 'Desktop and Android sync books, progress and compatible reading data directly through your WebDAV—no Torto relay.' },
      ],
      bannerH2: 'Ready to start reading?',
      bannerP: 'Download Torto for free on Windows 10/11, macOS 12+ and Android 7.0+.',
      footerCopy: '© {year} Torto · MIT License',
      footerDocs: 'Docs',
      footerReleases: 'Changelog',
    };
---

<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.desc} />
    <link rel="icon" type="image/png" href={`${base}images/logo.png`} />
    <script define:vars={{ base }}>
      // 语言自动切换：优先用户手动选择（localStorage），否则按浏览器语言
      (function () {
        var KEY = 'torto-lang';
        var rel = location.pathname.slice(base.length - 1); // 去掉 base 前缀，保留开头 /
        var isEn = rel === '/en' || rel.indexOf('/en/') === 0;
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) {}
        var pref = stored || ((navigator.language || 'en').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
        if (pref === 'en' && !isEn) location.replace(base + 'en' + (rel === '/' ? '/' : rel));
        else if (pref === 'zh' && isEn) location.replace(base + rel.replace(/^\/en\/?/, '') || base);
        // 手动点击语言切换时记住选择
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a.lang-switch') : null;
          if (a) { try { localStorage.setItem(KEY, isEn ? 'zh' : 'en'); } catch (err) {} }
        }, true);
      })();
    </script>
  </head>
  <body>
    <nav class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={homeHref}>
          <img src={`${base}images/logo.png`} alt="Torto" />
          <span>Torto</span>
        </a>
        <div class="nav-links">
          <a href={docsHref}>{t.navDocs}</a>
          <a href="https://github.com/TortoTech/torto">GitHub</a>
          <a class="lang-switch" href={langHref}>{t.langLabel}</a>
          <a class="nav-cta" href={downloadHref}>{t.navDownload}</a>
        </div>
      </div>
    </nav>

    <header class="hero">
      <div class="wrap hero-inner">
        <img class="hero-logo" src={`${base}images/logo.png`} alt="Torto logo" />
        <span class="badge">{t.badge}</span>
        <h1>{t.h1}</h1>
        <p class="lead">{t.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={downloadHref}>{t.ctaDownload}</a>
          <a class="btn btn-ghost" href={docsHref}>{t.ctaDocs}</a>
        </div>
      </div>
    </header>

    <section class="screenshots wrap">
      <div class="shot-grid">
        <figure>
          <img src={`${base}images/library.png`} alt={t.shotsLibrary} loading="lazy" />
          <figcaption>{t.shotsLibrary}</figcaption>
        </figure>
        <figure>
          <img src={`${base}images/reader.png`} alt={t.shotsReader} loading="lazy" />
          <figcaption>{t.shotsReader}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section wrap" id="platforms">
      <h2>{t.platformTitle}</h2>
      <p class="sub">{t.platformSub}</p>
      <div class="platform-grid">
        {t.platforms.map((platform) => (
          <article class="platform-card">
            <span class="platform-kicker">{platform.label}</span>
            <h3>{platform.title}</h3>
            <p>{platform.text}</p>
            <div class="platform-links">
              <a class="btn btn-primary" href={platform.primaryHref}>{platform.primary}</a>
              <a class="text-link" href={platform.secondaryHref}>{platform.secondary} ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section wrap" id="features">
      <h2>{t.featTitle}</h2>
      <p class="sub">{t.featSub}</p>
      <div class="feature-grid">
        {t.features.map((f) => (
          <div class="card">
            <div class="icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap">
      <div class="banner">
        <h2>{t.bannerH2}</h2>
        <p>{t.bannerP}</p>
        <a class="btn btn-primary" href={downloadHref}>{t.ctaDownload}</a>
      </div>
    </section>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>{t.footerCopy.replace('{year}', String(new Date().getFullYear()))}</span>
        <a href={docsHref}>{t.footerDocs}</a>
        <a href="https://github.com/TortoTech/torto/releases">{t.footerReleases}</a>
        <span class="right"><a href="https://github.com/TortoTech">github.com/TortoTech</a></span>
      </div>
    </footer>
  </body>
</html>
